# Admin panel settings. Add these in Netlify:
#   Site configuration → Environment variables, then redeploy.
# For local testing, copy this file to .env and run `npx netlify dev`.

# A long random string that signs login cookies (at least 24 characters).
# Make one with:  openssl rand -base64 48
ADMIN_SECRET=

# The owner account. This account always works and cannot be locked out by other users.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# A GitHub fine-grained token with Contents: Read and write on the site repository.
# GitHub → Settings → Developer settings → Fine-grained tokens.
GITHUB_TOKEN=

# The repository the admin edits, as owner/repo. Falls back to admin.repo in src/data/site.json.
GITHUB_REPO=
# The branch Netlify deploys from. Defaults to main.
GITHUB_BRANCH=main

# Optional: shows the latest deploy status on the admin dashboard.
# Netlify → User settings → Applications → Personal access tokens.
NETLIFY_API_TOKEN=
